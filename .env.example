# copy to .env — every key documented here
APP_ENV=local
DATABASE_URL=postgresql+psycopg://kirana:kirana@127.0.0.1:5433/kirana

# Telegram (BotFather token; secret must be A-Za-z0-9_- only, 1-256 chars)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=change-me-webhook-secret

# Admin / dev endpoints (X-Admin-Key) and dashboard JWT signing
ADMIN_API_KEY=change-me-admin-key
JWT_SECRET=change-me-jwt-secret

# STT: faster_whisper | groq | fixture
STT_PROVIDER=faster_whisper
# large-v3-turbo int8 needs ~1.5 GB RAM; small (~0.5 GB, 2.5 s per clip on CPU) fits a busy laptop. Measure with app.cli.stt_bench
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_DOWNLOAD_ROOT=          # blank = HF cache on the host; compose sets /models
MAX_VOICE_SECONDS=60
STT_MIN_AVG_LOGPROB=-1.0

# Parser: rules | llm | hybrid
PARSER_MODE=hybrid
# LLM provider chain, comma separated: ollama,groq,gemini
LLM_PROVIDERS=ollama,groq,gemini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_NUM_GPU=-1
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=qwen/qwen3.8-27b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash-lite

# Worker
WORKER_CONCURRENCY=2
RUN_WORKER_INLINE=false

# n8n (profile: tools)
N8N_PASSWORD=change-me-n8n

DASHBOARD_ORIGIN=*
