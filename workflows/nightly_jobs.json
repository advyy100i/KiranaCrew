{
 "name": "KiranaCrew - Nightly jobs 02:00",
 "nodes": [
  {
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "cronExpression",
       "expression": "0 2 * * *"
      }
     ]
    }
   },
   "name": "Every day 02:00",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "http://host.docker.internal:8000/internal/enqueue",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "options": {},
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "{\"kind\": \"FORECAST\", \"payload\": {\"shop_id\": 1}, \"dedupe_key\": \"forecast:{{ $now.toFormat('yyyy-LL-dd') }}\"}"
   },
   "name": "Enqueue FORECAST",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    260,
    0
   ],
   "credentials": {
    "httpHeaderAuth": {
     "id": "ADMIN_KEY",
     "name": "KiranaCrew admin key (X-Admin-Key)"
    }
   }
  },
  {
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "strict"
     },
     "conditions": [
      {
       "id": "c1",
       "leftValue": "={{ $now.weekday }}",
       "rightValue": 7,
       "operator": {
        "type": "number",
        "operation": "equals"
       }
      }
     ],
     "combinator": "and"
    },
    "options": {}
   },
   "name": "Sunday?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2,
   "position": [
    520,
    0
   ]
  },
  {
   "parameters": {
    "method": "POST",
    "url": "http://host.docker.internal:8000/internal/enqueue",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "options": {},
    "sendBody": true,
    "specifyBody": "json",
    "jsonBody": "{\"kind\": \"INSIGHTS\", \"payload\": {\"shop_id\": 1}, \"dedupe_key\": \"insights:{{ $now.toFormat('kkkk-WW') }}\"}"
   },
   "name": "Enqueue INSIGHTS",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    780,
    0
   ],
   "credentials": {
    "httpHeaderAuth": {
     "id": "ADMIN_KEY",
     "name": "KiranaCrew admin key (X-Admin-Key)"
    }
   }
  },
  {
   "parameters": {
    "content": "READ-ONLY BY DESIGN (ADR-004): this workflow only calls admin-key GET/POST endpoints that read or enqueue, and a read-only Postgres role. It cannot create a transaction. If n8n is down, bookkeeping is unaffected.",
    "height": 160,
    "width": 420
   },
   "name": "Boundary note",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    0,
    -220
   ]
  }
 ],
 "connections": {
  "Every day 02:00": {
   "main": [
    [
     {
      "node": "Enqueue FORECAST",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Enqueue FORECAST": {
   "main": [
    [
     {
      "node": "Sunday?",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Sunday?": {
   "main": [
    [
     {
      "node": "Enqueue INSIGHTS",
      "type": "main",
      "index": 0
     }
    ],
    []
   ]
  }
 },
 "active": false,
 "settings": {
  "timezone": "Asia/Kolkata",
  "executionOrder": "v1"
 },
 "pinData": {}
}