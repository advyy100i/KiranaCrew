{
 "name": "KiranaCrew - Failed message alert (15m)",
 "nodes": [
  {
   "parameters": {
    "rule": {
     "interval": [
      {
       "field": "cronExpression",
       "expression": "*/15 * * * *"
      }
     ]
    }
   },
   "name": "Every 15 min",
   "type": "n8n-nodes-base.scheduleTrigger",
   "typeVersion": 1.2,
   "position": [
    0,
    0
   ]
  },
  {
   "parameters": {
    "method": "GET",
    "url": "http://host.docker.internal:8000/dev/stats",
    "authentication": "genericCredentialType",
    "genericAuthType": "httpHeaderAuth",
    "options": {}
   },
   "name": "GET /dev/stats",
   "type": "n8n-nodes-base.httpRequest",
   "typeVersion": 4.2,
   "position": [
    260,
    0
   ],
   "credentials": {
    "httpHeaderAuth": {
     "id": "ADMIN_KEY",
     "name": "KiranaCrew admin key (X-Admin-Key)"
    }
   }
  },
  {
   "parameters": {
    "conditions": {
     "options": {
      "caseSensitive": true,
      "leftValue": "",
      "typeValidation": "strict"
     },
     "conditions": [
      {
       "id": "c1",
       "leftValue": "={{ $json.failed_messages }}",
       "rightValue": 0,
       "operator": {
        "type": "number",
        "operation": "gt"
       }
      },
      {
       "id": "c2",
       "leftValue": "={{ $json.queue_depth }}",
       "rightValue": 20,
       "operator": {
        "type": "number",
        "operation": "gt"
       }
      },
      {
       "id": "c3",
       "leftValue": "={{ $json.dead_jobs }}",
       "rightValue": 0,
       "operator": {
        "type": "number",
        "operation": "gt"
       }
      }
     ],
     "combinator": "or"
    },
    "options": {}
   },
   "name": "Unhealthy?",
   "type": "n8n-nodes-base.if",
   "typeVersion": 2,
   "position": [
    520,
    0
   ]
  },
  {
   "parameters": {
    "chatId": "={{ $env.OPERATOR_CHAT_ID }}",
    "text": "=🚨 KiranaCrew: failed_messages={{ $json.failed_messages }} dead_jobs={{ $json.dead_jobs }} queue_depth={{ $json.queue_depth }}",
    "additionalFields": {}
   },
   "name": "Alert operator",
   "type": "n8n-nodes-base.telegram",
   "typeVersion": 1.2,
   "position": [
    780,
    0
   ],
   "credentials": {
    "telegramApi": {
     "id": "TG",
     "name": "KiranaCrew bot"
    }
   }
  },
  {
   "parameters": {
    "content": "READ-ONLY BY DESIGN (ADR-004): this workflow only calls admin-key GET/POST endpoints that read or enqueue, and a read-only Postgres role. It cannot create a transaction. If n8n is down, bookkeeping is unaffected. Alerts go to the operator, not the shopkeeper.",
    "height": 160,
    "width": 420
   },
   "name": "Boundary note",
   "type": "n8n-nodes-base.stickyNote",
   "typeVersion": 1,
   "position": [
    0,
    -220
   ]
  }
 ],
 "connections": {
  "Every 15 min": {
   "main": [
    [
     {
      "node": "GET /dev/stats",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "GET /dev/stats": {
   "main": [
    [
     {
      "node": "Unhealthy?",
      "type": "main",
      "index": 0
     }
    ]
   ]
  },
  "Unhealthy?": {
   "main": [
    [
     {
      "node": "Alert operator",
      "type": "main",
      "index": 0
     }
    ],
    []
   ]
  }
 },
 "active": false,
 "settings": {
  "timezone": "Asia/Kolkata",
  "executionOrder": "v1"
 },
 "pinData": {}
}